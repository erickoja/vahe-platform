# Copy this file to .env.local and fill in your Supabase project values.
# Find these in your Supabase dashboard → Project Settings → API.
# (.env.local is gitignored — your keys never get committed.)
#
# IMPORTANT: .env.local is for LOCAL DEV ONLY. The live sites use their own
# PRODUCTION projects configured in Vercel's environment variables — NOT here.
# There is currently no dedicated dev/sandbox Supabase project (the old one was
# deleted 10 Aug 2026), so to run a local sandbox you'd create a fresh Supabase
# project and point .env.local at it. See ENVIRONMENTS.md for the full picture.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Public self-serve sign-up. Leave UNSET/false on the single-tenant business
# deployment (admin-created logins only). Set to "true" ONLY on the multi-tenant
# TESTER deployment, so jewellers can create their own studio.
# VITE_ALLOW_SIGNUP=true
