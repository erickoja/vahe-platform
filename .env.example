# Copy this file to .env.local and fill in your Supabase project values.
# Find these in your Supabase dashboard → Project Settings → API.
# (.env.local is gitignored — your keys never get committed.)
#
# IMPORTANT: .env.local is for LOCAL DEV ONLY and should point at the DEV
# Supabase project (khpykxoshyljqkauvdfn / "vahe-dev"). The LIVE site uses a
# DIFFERENT, PRODUCTION project (ipbillmpehwgnlayyziz), configured in Vercel's
# environment variables — NOT here. See ENVIRONMENTS.md for the full picture.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Public self-serve sign-up. Leave UNSET/false on the single-tenant business
# deployment (admin-created logins only). Set to "true" ONLY on the multi-tenant
# TESTER deployment, so jewellers can create their own studio.
# VITE_ALLOW_SIGNUP=true
